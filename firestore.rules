rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- HELPERS ----------
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }
    function isAgent() {
      return isAuth() && request.auth.token.role == 'agent';
    }
    function isMerchant() {
      return isAuth() && request.auth.token.role == 'merchant';
    }
    function isVerified() {
      return isAuth() && request.auth.token.kycStatus == 'verified';
    }

    // ---------- USERS ----------
    // Le propriétaire lit son doc public. La modification est
    // restreinte aux champs non sensibles (le solde est serveur-only).
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isAgent();
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['balance', 'currency', 'kycStatus', 'role', 'frozen', 'pinHash']);
      allow create, delete: if false; // créé uniquement par Cloud Function
    }

    // ---------- COMPTES (soldes) — lecture seule côté client ----------
    match /accounts/{accountId} {
      allow read: if isAuth()
        && (resource.data.ownerUid == request.auth.uid || isAdmin() || isAgent());
      allow write: if false; // JAMAIS côté client, toujours via Function
    }

    // ---------- TRANSACTIONS (double-entrée) ----------
    match /transactions/{txId} {
      allow read: if isAuth()
        && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow write: if false; // idem
    }

    // ---------- DÉPÔTS / RETRAITS (payout requests) ----------
    match /payouts/{payoutId} {
      allow read: if isAuth()
        && (resource.data.uid == request.auth.uid || isAdmin() || isAgent());
      allow write: if false;
    }
    match /deposits/{depositId} {
      allow read: if isAuth()
        && (resource.data.uid == request.auth.uid || isAdmin() || isAgent());
      allow write: if false;
    }

    // ---------- KYC ----------
    match /kyc/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // soumis via Function
    }

    // ---------- QR / SHOP ----------
    match /shops/{shopId} {
      allow read: if true; // les QR publics sont lisibles
      allow write: if isAuth()
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['balance']);
    }
    match /shops/{shopId}/sales/{saleId} {
      allow read: if isAuth()
        && (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---------- AUDIT LOG ----------
    match /audit/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow write: if false;
    }

    // ---------- ADMIN ONLY (config, rates) ----------
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ---------- TOUT LE RESTE : REFUS ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
